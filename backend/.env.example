# SolarVerse backend environment configuration
# Copy this file to .env and replace placeholder values locally.

APPLICATION_NAME=SolarVerse
API_V1_PREFIX=/api/v1
DEBUG=false
ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# Optional for local use; required when ENVIRONMENT=production.
JWT_ALGORITHM=HS256
# JWT_ISSUER=https://api.example.com
# JWT_AUDIENCE=solarverse-web
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL via Psycopg 3. Never commit a real password.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
